echo "Installing packages for Fedora"

install_packages() {
    sudo dnf -y install $@
}

{{ if eq .chezmoi.osRelease.id "nobara" -}}
nobara-sync cli
{{ else -}}
sudo dnf update -y
{{ end -}}

# System Utilities
install_packages {{ .packages | join " " }} btop util-linux-user perl-File-Compare openssl-devel gcc g++

sudo dnf config-manager addrepo --from-repofile=https://download.opensuse.org/repositories/isv:/BrowserWorks/Fedora_{{ .chezmoi.osRelease.versionID }}/isv:BrowserWorks.repo

copr_repos=(lihaohong/yazi scottames/ghostty)
for repo in "${copr_repos[@]}"; do
    if ! dnf copr list | grep -qF "$repo"; then
        sudo dnf copr enable "$repo"
    fi
done

# GUI applications
install_packages ghostty yazi waterfox

